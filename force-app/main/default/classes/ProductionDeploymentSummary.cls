private static Decimal calculateGoLiveReadinessScore(List<Go_Live_Checklist__c> checklistItems) {
    Integer totalItems = checklistItems.size();
    Integer completedItems = 0;
    Integer criticalItems = 0;
    Integer completedCriticalItems = 0;

    for (Go_Live_Checklist__c item : checklistItems) {
        if (item.Status__c == 'Completed') {
            completedItems++;
        }
        if (item.Critical__c == true) {
            criticalItems++;
            if (item.Status__c == 'Completed') {
                completedCriticalItems++;
            }
        }
    }

    // Calculate base score
    Decimal baseScore = totalItems > 0 ? (Decimal.valueOf(completedItems) / Decimal.valueOf(totalItems)) * 100 : 0;

    // Apply critical item weight (critical items must be 100% complete for full score)
    Decimal criticalScore = criticalItems > 0 ? (Decimal.valueOf(completedCriticalItems) / Decimal.valueOf(criticalItems)) * 100 : 100;

    // Final score is weighted average (70% base score, 30% critical score emphasis)
    Decimal finalScore = (baseScore * 0.7) + (criticalScore * 0.3);

    return finalScore.setScale(1);
}

