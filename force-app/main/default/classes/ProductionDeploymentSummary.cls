    // Production readiness validation
    public static Boolean validateProductionReadiness() {
        Boolean isReady = true;
        List<String> readinessIssues = new List<String>();
        
        try {
            // Check custom objects
            List<String> requiredObjects = new List<String>{
                'Document_Generation_Request__c',
                'ESignature_Request__c',
                'Performance_Metric__c',
                'System_Alert__c',
                'Monitoring_Configuration__c',
                'System_Health_Log__c',
                'Deployment_Metrics__c',
                'Deployment_Notification__c'
            };
            
            for (String objectName : requiredObjects) {
                try {
                    SObjectType objType = Schema.getGlobalDescribe().get(objectName);
                    if (objType == null) {
                        readinessIssues.add('Missing custom object: ' + objectName);
                        isReady = false;
                    }
                } catch (Exception e) {
                    readinessIssues.add('Error validating object ' + objectName + ': ' + e.getMessage());
                    isReady = false;
                }
            }
            
            // Check Apex classes
            List<String> requiredClasses = new List<String>{
                'DocumentLifecycleDeploymentManager',
                'SignatureRequestController',
                'ProductionMonitoringController',
                'ProductionDeploymentExecutor',
                'ProductionVerificationScript'
            };
            
            // Note: In a real implementation, you would query ApexClass object
            // For this demo, we'll assume classes exist if no exceptions are thrown
            
            // Check Lightning Web Components
            // Note: In a real implementation, you would check component metadata
            
            // Check permissions and access
            if (!Schema.sObjectType.Document_Generation_Request__c.isCreateable()) {
                readinessIssues.add('Insufficient permissions for Document_Generation_Request__c');
                isReady = false;
            }
            
            if (!Schema.sObjectType.ESignature_Request__c.isCreateable()) {
                readinessIssues.add('Insufficient permissions for ESignature_Request__c');
                isReady = false;
            }
            
            // Validate integration endpoints
            List<Named_Credential__mdt> credentials = [
            SELECT Id, Endpoint__c 
            FROM Named_Credential__mdt 
            WHERE DeveloperName IN ('DocuSign_API', 'Adobe_Sign_API')
        ];
            
            if (credentials.size() < 2)
                List<Named_Credential__mdt> credentials = [
    SELECT Id, Endpoint__c 
    FROM Named_Credential__mdt 
    WHERE DeveloperName IN ('DocuSign_API', 'Adobe_Sign_API')
];
            
            if (credentials.size() < 2) {
                readinessIssues.add('Missing required named credentials for external integrations');
                isReady = false;
            }
            
            // Check system limits and governor limits
            Map<String, System.OrgLimit> limits = System.OrgLimits.getMap();
            if (limits.containsKey('DataStorageMB')) {
                Integer storageUsed = limits.get('DataStorageMB').getValue();
                Integer storageLimit = limits.get('DataStorageMB').getLimit();
                if (storageUsed > (storageLimit * 0.8)) {
                    readinessIssues.add('Data storage usage > 80% - may impact performance');
                    isReady = false;
                }
            }
            
            // Validate file storage capacity
            if (limits.containsKey('FileStorageMB')) {
                Integer fileStorageUsed = limits.get('FileStorageMB').getValue();
                Integer fileStorageLimit = limits.get('FileStorageMB').getLimit();
                if (fileStorageUsed > (fileStorageLimit * 0.8)) {
                    readinessIssues.add('File storage usage > 80% - may impact document generation');
                    isReady = false;
                }
            }
            
            // Check API request limits
            if (limits.containsKey('DailyApiRequests')) {
                Integer apiUsed = limits.get('DailyApiRequests').getValue();
                Integer apiLimit = limits.get('DailyApiRequests').getLimit();
                if (apiUsed > (apiLimit * 0.7)) {
                    readinessIssues.add('API usage > 70% - may impact integrations');
                    isReady = false;
                }
            }
            
            // Validate essential configuration records
            List<DocumentLifecycleConfiguration__c> configs = [
    SELECT Id FROM DocumentLifecycleConfiguration__c 
    WHERE Active__c = true 
    LIMIT 1
];
            if (configs.isEmpty()) {
                readinessIssues.add('No active document lifecycle configurations found');
                isReady = false;
            }
            
            // Check for required permission sets
            List<PermissionSet> requiredPermSets = [
    SELECT Id, Name 
    FROM PermissionSet 
    WHERE Name IN ('DocumentGenerationAdmin', 'DocumentGenerationUser')
];
            if (requiredPermSets.size() < 2) {
                readinessIssues.add('Missing required permission sets');
                isReady = false;
            }
            
            // Validate Lightning components accessibility
            // Note: This is a simplified check - in production you'd verify actual component metadata
            try {
                // Attempt to access component-related objects to verify deployment
                List<ContentDocument> testContentAccess = [SELECT Id FROM ContentDocument LIMIT 1];
                System.debug('Content access verified');
            } catch (Exception e) {
                readinessIssues.add('Lightning component file access issues: ' + e.getMessage());
                isReady = false;
            }
            
            // Check system performance baseline
            List<Performance_Metric__c> recentMetrics = [
    SELECT Metric_Value__c, Alert_Status__c
    FROM Performance_Metric__c 
    WHERE CreatedDate = TODAY
    AND Alert_Status__c = 'Critical'
];
            if (!recentMetrics.isEmpty()) {
                readinessIssues.add('Critical performance issues detected in recent metrics');
                isReady = false;
            }
            
            // Validate backup and recovery procedures
            try {
                // Check if backup configurations exist
                List<System_Configuration__c> backupConfigs = [
        SELECT Id FROM System_Configuration__c 
        WHERE Configuration_Type__c = 'Backup_Schedule' 
        AND Active__c = true
    ];
                if (backupConfigs.isEmpty()) {
                    readinessIssues.add('Backup procedures not configured');
                    isReady = false;
                }
            } catch (Exception e) {
                System.debug('Backup validation warning: ' + e.getMessage());
            }
            
        } catch (Exception e) {
            readinessIssues.add('Production readiness validation failed: ' + e.getMessage());
            isReady = false;
        }
        
        // Log readiness assessment
        Production_Readiness_Assessment__c assessment = new Production_Readiness_Assessment__c(
            Assessment_Date__c = Date.today(),
        Is_Production_Ready__c = isReady,
        Issues_Count__c = readinessIssues.size(),
        Assessment_Details__c = String.join(readinessIssues, '\n'),
        Assessed_By__c = UserInfo.getUserId(),
        Overall_Score__c = isReady ? 100 : Math.max(0, 100 - (readinessIssues.size() * 10))
            );
        
        try {
            insert assessment;
            System.debug('📋 Production readiness assessment recorded: ' + assessment.Id);
        } catch (Exception e) {
            System.debug('⚠️ Could not save readiness assessment: ' + e.getMessage());
        }
        
        // Display readiness status
        if (isReady) {
            System.debug('✅ PRODUCTION READY - All validation checks passed');
        } else {
            System.debug('❌ PRODUCTION NOT READY - Issues found:');
            for (String issue : readinessIssues) {
                System.debug('  • ' + issue);
            }
        }
        
        return isReady;
    }
    
