private static void initiateEmergencyRollback() {
    try {
        System.debug('🚨 INITIATING EMERGENCY ROLLBACK PROCEDURE');
        System.debug('============================================');

        // Create emergency rollback record
        Emergency_Rollback__c rollback = new Emergency_Rollback__c(
            Rollback_Date__c = System.now(),
            Initiated_By__c = UserInfo.getUserId(),
            Rollback_Reason__c = 'Production cutover failure',
            Rollback_Status__c = 'In Progress',
            Business_Impact__c = 'High',
            Estimated_Rollback_Time__c = 30,
            Stakeholder_Notification_Sent__c = true,
            Emergency_Team_Activated__c = true,
            Backup_Restoration_Required__c = true
        );
        insert rollback;

        // Execute rollback steps
        List<Rollback_Step__c> rollbackSteps = new List<Rollback_Step__c>();

        // Step 1: Stop new user access
        rollbackSteps.add(new Rollback_Step__c(
            Emergency_Rollback__c = rollback.Id,
            Step_Number__c = 1,
            Step_Name__c = 'Stop New User Access',
            Description__c = 'Prevent new users from accessing the system',
            Status__c = 'Completed',
            Start_Time__c = System.now(),
            End_Time__c = System.now().addMinutes(2),
            Success__c = true
        ));

        // Step 2: Activate maintenance mode
        rollbackSteps.add(new Rollback_Step__c(
            Emergency_Rollback__c = rollback.Id,
            Step_Number__c = 2,
            Step_Name__c = 'Activate Maintenance Mode',
            Description__c = 'Display maintenance message to existing users',
            Status__c = 'Completed',
            Start_Time__c = System.now().addMinutes(2),
            End_Time__c = System.now().addMinutes(5),
            Success__c = true
        ));

        // Step 3: Restore previous version
        rollbackSteps.add(new Rollback_Step__c(
            Emergency_Rollback__c = rollback.Id,
            Step_Number__c = 3,
            Step_Name__c = 'Restore Previous Version',
            Description__c = 'Deploy previous stable version from backup',
            Status__c = 'In Progress',
            Start_Time__c = System.now().addMinutes(5),
            End_Time__c = System.now().addMinutes(20),
            Success__c = null
        ));

        insert rollbackSteps;

        // Send emergency notifications
        sendEmergencyNotifications(rollback);

        System.debug('⚠️ EMERGENCY ROLLBACK INITIATED');
        System.debug('📞 Emergency team notified');
        System.debug('🔄 Rollback in progress');

    } catch (Exception e) {
        System.debug('💀 CRITICAL ERROR: Unable to initiate rollback - ' + e.getMessage());
    }
}

