/**
 * @description Global batch class responsible for generating and distributing scheduled analytics reports.
 * It iterates through a list of report types, generates each one, and sends an email notification.
 * @implements Database.Batchable<String>, Database.Stateful
 */
global class ScheduledAnalyticsReportBatch implements Database.Batchable<String>, Database.Stateful {
    private List<String> reportTypes;
    private DateTime periodStart;
    private DateTime periodEnd;
    private String emailRecipients;

    /**
     * @description Constructor for the batch job.
     * @param reportTypes List of report types to generate (e.g., 'EXECUTIVE_SUMMARY').
     * @param periodStart The start date/time for the report period.
     * @param periodEnd The end date/time for the report period.
     * @param emailRecipients A semicolon-separated string of recipient email addresses.
     */
    global ScheduledAnalyticsReportBatch(List<String> reportTypes, DateTime periodStart, DateTime periodEnd, String emailRecipients) {
        this.reportTypes = reportTypes;
        this.periodStart = periodStart;
        this.periodEnd = periodEnd;
        this.emailRecipients = emailRecipients;
    }

    /**
     * @description The start method returns the iterable (list of report types) to be processed.
     */
    global Iterable<String> start(Database.BatchableContext bc) {
        return reportTypes;
    }

    /**
     * @description The execute method processes each batch of report types. For each type, it generates
     * a comprehensive report and sends a notification.
     */
    global void execute(Database.BatchableContext bc, List<String> reportTypeBatch) {
        for (String reportType : reportTypeBatch) {
            try {
                // Generate the report by calling an external manager/engine method
                AnalyticsReport report = generateComprehensiveReport(reportType, periodStart, periodEnd);
                
                // Send an email notification if recipients are configured
                if (String.isNotBlank(emailRecipients)) {
                    sendReportNotification(report, emailRecipients.split(';'));
                }
            } catch (Exception e) {
                // Log the error for a specific report but allow the batch to continue
                System.debug('Error generating scheduled report ' + reportType + ': ' + e.getMessage());
            }
        }
    }

    /**
     * @description The finish method logs a completion message after all batches are processed.
     */
    global void finish(Database.BatchableContext bc) {
        System.debug('Scheduled analytics reports generation completed');
    }

    /**
     * @description Private helper method to construct and send the report notification email.
     */
    private void sendReportNotification(AnalyticsReport report, List<String> recipients) {
        try {
            Messaging.SingleEmailMessage email = new Messaging.SingleEmailMessage();
            email.setToAddresses(recipients);
            email.setSubject('Analytics Report: ' + report.reportType + ' - ' + Date.today().format());
            
            String emailBody = 'Analytics Report Generated\n\n';
            emailBody += 'Report Type: ' + report.reportType + '\n';
            emailBody += 'Period: ' + report.periodStart.format('MM/dd/yyyy') + ' - ' + report.periodEnd.format('MM/dd/yyyy') + '\n';
            emailBody += 'Overall Score: ' + report.overallScore.format() + '%\n';
            emailBody += 'Generated By: ' + report.generatedBy + '\n\n';
            
            if (report.hasAnomalies) {
                emailBody += '️ ATTENTION: Anomalies detected in this report\n\n';
            }
            
            emailBody += 'Executive Summary:\n';
            emailBody += report.executiveSummary + '\n';
            
            if (report.insights != null && !report.insights.isEmpty()) {
                emailBody += '\nKey Insights:\n';
                for (Integer i = 0; i < Math.min(5, report.insights.size()); i++) {
                    AnalyticsInsight insight = report.insights[i];
                    emailBody += '• [' + insight.severity + '] ' + insight.title + '\n';
                }
            }
            
            List<String> recommendations = generateRecommendedActions(report);
            if (recommendations != null && !recommendations.isEmpty()) {
                emailBody += '\nRecommended Actions:\n';
                for (Integer i = 0; i < Math.min(5, recommendations.size()); i++) {
                    emailBody += '• ' + recommendations[i] + '\n';
                }
            }
            
            emailBody += '\nFor detailed charts and analysis, access the full report in Salesforce.\n';
            email.setPlainTextBody(emailBody);
            Messaging.sendEmail(new Messaging.SingleEmailMessage[]{email});
        } catch (Exception e) {
            System.debug('Error sending report notification: ' + e.getMessage());
        }
    }

    /**
     * @description Static method to schedule the daily and weekly analytics reports.
     * This method would typically be called from a post-deploy script or executed manually.
     */
    public static void scheduleAnalyticsReports() {
        try {
            DateTime now = System.now();
            Date today = now.date();

            // Schedule daily reports for the previous day
            DateTime startOfDay = DateTime.newInstance(today.addDays(-1), Time.newInstance(0, 0, 0, 0));
            DateTime endOfDay = DateTime.newInstance(today.addDays(-1), Time.newInstance(23, 59, 59, 999));
            List<String> dailyReports = new List<String>{'EXECUTIVE_SUMMARY'};
            String dailyRecipients = 'executives@company.com;operations@company.com';
            
            ScheduledAnalyticsReportBatch dailyBatch = new ScheduledAnalyticsReportBatch(dailyReports, startOfDay, endOfDay, dailyRecipients);
            Database.executeBatch(dailyBatch, 1);

            // Schedule weekly reports on Mondays for the previous week
            if (now.format('E').equals('Mon')) {
                DateTime startOfWeek = startOfDay.addDays(-6);
                List<String> weeklyReports = new List<String>{'DOCUMENT_GENERATION', 'COMPLIANCE_OVERVIEW', 'SYSTEM_PERFORMANCE', 'USER_ACTIVITY'};
                String weeklyRecipients = 'management@company.com;it-team@company.com;compliance@company.com';

                ScheduledAnalyticsReportBatch weeklyBatch = new ScheduledAnalyticsReportBatch(weeklyReports, startOfWeek, endOfDay, weeklyRecipients);
                Database.executeBatch(weeklyBatch, 1);
            }
        } catch (Exception e) {
            System.debug('Error scheduling analytics reports: ' + e.getMessage());
        }
    }
    
    // Placeholder for external dependency methods
    private static AnalyticsReport generateComprehensiveReport(String reportType, DateTime periodStart, DateTime periodEnd) { /* Assumed to be defined elsewhere */ return new AnalyticsReport(); }
    private static List<String> generateRecommendedActions(AnalyticsReport report) { /* Assumed to be defined elsewhere */ return new List<String>(); }
    
    // Placeholder for dependent inner classes
    global class AnalyticsReport { public String reportType; public DateTime periodStart; public DateTime periodEnd; public Decimal overallScore; public String generatedBy; public Boolean hasAnomalies; public String executiveSummary; public List<AnalyticsInsight> insights; }
    global class AnalyticsInsight { public String severity; public String title; }
}